{
  "name": "editing-experiment",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight ingest, captioning, develop and FTP app for sports photographers.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck && tsc --noEmit -p scripts",
    "test": "node scripts/ensure-electron.mjs && pnpm build:native && pnpm test:unit && pnpm test:e2e",
    "build:native": "pnpm --filter @ee/core run build",
    "build": "pnpm -r --workspace-concurrency=1 run --if-present build",
    "dev": "pnpm build:native && pnpm --filter @ee/desktop run dev",
    "screenshot": "pnpm build && node scripts/screenshot.ts",
    "fetch-fixtures": "node scripts/fetch-fixtures.ts",
    "fetch-retouch": "node scripts/fetch-retouch.ts",
    "update-lensfun": "pnpm --filter @ee/develop-gl run update-lensfun",
    "test:unit": "vitest run --exclude '**/*.e2e.test.ts' --exclude '**/real-mode.smoke.test.ts'",
    "test:e2e": "vitest run --no-file-parallelism apps/desktop/test/poc-demo.e2e.test.ts apps/desktop/test/real-mode.smoke.test.ts",
    "test:e2e:demo": "vitest run --no-file-parallelism apps/desktop/test/poc-demo.e2e.test.ts --testNamePattern='^(?!.*Lightroom-style crop overlay).*'",
    "test:e2e:crop": "vitest run --no-file-parallelism apps/desktop/test/poc-demo.e2e.test.ts apps/desktop/test/real-mode.smoke.test.ts --testNamePattern='Lightroom-style crop overlay|real mode smoke'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
